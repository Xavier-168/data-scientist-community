# 社区版默认不连接许可证、更新或反馈服务。
# 仅当你自行部署相应服务并理解隐私影响后再填写。
YIRENGONGIS_ACTIVATION_SERVER=
YIRENGONGIS_ACTIVATION_SERVER_FALLBACKS=
YRG_UPDATE_SERVER=
YRG_FEEDBACK_ENDPOINT=

# 可选：更改本地监听地址和端口。
YIRENGONGIS_RUNNER_HOST=127.0.0.1
YIRENGONGIS_RUNNER_PORT=8811

# 飞书凭据通过应用设置页保存到本机运行目录，不要提交到 Git。
FEISHU_APP_ID=<your-app-id>
FEISHU_APP_SECRET=<your-app-secret>
